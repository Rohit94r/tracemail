{
  "name": "@raven/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev",
    "dev:backend": "python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8001 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "python3 -m pytest backend/tests",
