    "score": "python3 -m backend.app.cli score",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.4.5",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
