# SIH26159 SecureMailScope — environment template
# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env

# --- Database (required for the evidence store) ---
# MongoDB Atlas SRV string, with real credentials.
# Get it from Atlas -> Database Access -> your user -> "Add IP Access List" /
# "Connection String". Create a dedicated least-privilege user for this app.
MONGO_URI=
MONGO_DB_NAME=platform

# --- Backend engine ---
PORT=8001

# Origins allowed to call the API. Comma-separated, no wildcards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
# NOTE: NEXT_PUBLIC_* values are compiled into the client bundle and are
# therefore public. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/live

# --- RAG assistant (optional; the /api/v1/ask endpoint) ---
# The assistant is grounded in retrieval over local RFC text, the scoring rubric
# and the findings computed for the upload. It has no other knowledge source and
# refuses anything it cannot cite. With no key configured, the endpoint returns a
# clear refusal rather than an ungrounded answer, so the rest of the product is
# unaffected.
# Key: console.groq.com -> API Keys. Read the available model list from
# https://api.groq.com/openai/v1/models and set GROQ_MODEL to one your key can use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
